### Event Ticketing API — sample requests
### Use with the IntelliJ HTTP client or the VS Code "REST Client" extension.
@host = http://localhost:8080

############################################################
# CATALOG (admin)
############################################################

### Create an organizer
POST {{host}}/api/organizers
Content-Type: application/json

{ "name": "Starlight Productions", "email": "hello@starlight.example", "phone": "+1-555-0100" }

### Create a SEATED hall (5 rows x 8 cols in a default section)
POST {{host}}/api/halls
Content-Type: application/json

{
  "name": "Grand Theatre",
  "address": "10 Opera Ave",
  "seated": true,
  "numRows": 5,
  "numColumns": 8
}

### Create a NON-SEATED (general admission) hall
POST {{host}}/api/halls
Content-Type: application/json

{ "name": "Open Arena", "address": "200 Festival Rd", "seated": false, "capacity": 300 }

### Get hall detail (includes generated seats)
GET {{host}}/api/halls/1

### Create an event (starts in DRAFT). Adjust organizerId / hallId / dates.
POST {{host}}/api/events
Content-Type: application/json

{
  "name": "Symphony Under the Stars",
  "description": "An evening of orchestral classics.",
  "category": "Music",
  "startAt": "2026-08-01T19:00:00Z",
  "endAt": "2026-08-01T22:00:00Z",
  "organizerId": 1,
  "hallId": 1,
  "maxCapacity": 40
}

### Set section pricing for the seated event (use the section id returned with the hall)
PUT {{host}}/api/events/1/pricing
Content-Type: application/json

{
  "prices": [
    { "sectionId": 1, "price": 100.00 }
  ]
}

### Publish the event (requires complete pricing)
PATCH {{host}}/api/events/1/status
Content-Type: application/json

{ "status": "PUBLISHED" }

############################################################
# MOBILE (booking flow)
############################################################

### List available events
GET {{host}}/api/events/available

### Event detail (hall, pricing, status)
GET {{host}}/api/events/1

### Live seat map for a seated event (poll this)
GET {{host}}/api/events/1/seats

### Live availability for a non-seated event (poll this)
GET {{host}}/api/events/2/availability

### Reserve up to 2 seats (seated). Use seat ids from the seat map.
POST {{host}}/api/bookings
Content-Type: application/json

{ "eventId": 1, "customerRef": "user-42", "seatIds": [1, 2] }

### Reserve general-admission tickets. Use GA section ids from the seat map.
POST {{host}}/api/bookings
Content-Type: application/json

{ "eventId": 2, "customerRef": "user-42", "generalAdmission": [{ "sectionId": 3, "quantity": 2 }] }

### Reserve seats and GA tickets from several sections in one order (max 10 tickets in total)
POST {{host}}/api/bookings
Content-Type: application/json

{
  "eventId": 1,
  "customerRef": "user-42",
  "seatIds": [1, 2],
  "generalAdmission": [
    { "sectionId": 4, "quantity": 3 },
    { "sectionId": 5, "quantity": 1 }
  ]
}

### Get a booking (check status / expiry).
### Booking-scoped calls require X-Customer-Ref = the customerRef that owns the booking;
### a mismatch returns 404 so ids can't be probed.
GET {{host}}/api/bookings/1
X-Customer-Ref: user-42

### Replace the whole selection of an unpaid hold (keeps the hold deadline).
### Omitting generalAdmission removes every GA ticket; omitting seatIds removes every seat.
PUT {{host}}/api/bookings/1/items
Content-Type: application/json
X-Customer-Ref: user-42

{ "seatIds": [2], "generalAdmission": [{ "sectionId": 4, "quantity": 5 }] }

### Change only the seats on an unpaid hold (GA tickets and the hold deadline are kept)
PUT {{host}}/api/bookings/1/seats
Content-Type: application/json
X-Customer-Ref: user-42

{ "seatIds": [2, 3] }

### Pay (fake gateway — always succeeds; confirms the hold)
POST {{host}}/api/bookings/1/payment
X-Customer-Ref: user-42

### Cancel a pending hold (releases the seats)
DELETE {{host}}/api/bookings/1
X-Customer-Ref: user-42
